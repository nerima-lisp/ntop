(in-package #:ntop.test)

(cl-weave:describe "BTM help dialog composition"
  (cl-weave:it "centers the 96 by 27 frame and clears dashboard cells"
    (let* ((draw-count 0)
           (config (ntop.shared.application:make-application-config))
           (composition
             (ntop.app.application:make-application-composition
              config :draw-screen
              (lambda (target draw-state draw-config snapshot columns rows reasons series)
                (declare (ignore draw-state draw-config snapshot columns rows reasons series))
                (incf draw-count)
                (cl-tty-kit:screen-write-string target 0 0 "dashboard")
                nil)))
           (render (ntop.app.application:application-composition-render composition))
           (state (ntop.app.domain:make-app-state :selected-widget :process)))
      (setf (ntop.app.domain:app-state-active-dialog state) :help)
      (with-output-to-string (stream)
        (let ((*standard-output* stream))
          (funcall render state config nil 120 40 nil)))
      (let* ((screen (ntop.app.application::application-composition-screen composition))
             (top (cl-tty-kit:screen-row-string screen 6))
             (intro (cl-tty-kit:screen-row-string screen 7))
             (toc (cl-tty-kit:screen-row-string screen 8))
             (general (cl-tty-kit:screen-row-string screen 20))
             (quit (cl-tty-kit:screen-row-string screen 21))
             (bottom (cl-tty-kit:screen-row-string screen 32))
             (outside (cl-tty-kit:screen-row-string screen 0)))
        (cl-weave:expect draw-count :to-be 1)
        (cl-weave:expect
         (mapcar
          (lambda (columns)
            (ntop.ui:rectangle-width
             (ntop.app.application::%help-dialog-rectangle columns 40)))
          '(94 95 96 97 98 120))
         :to-equal '(94 95 96 95 96 96))
        (cl-weave:expect (char top 12) :to-equal #\┌)
        (cl-weave:expect (search " Help " top) :to-be 13)
        (cl-weave:expect (search "Esc to close" top) :to-be 94)
        (cl-weave:expect (search "Scroll to browse or press the number key" intro)
                         :to-be 13)
        (cl-weave:expect (search "1 - General" toc) :to-be 13)
        (cl-weave:expect (search "1 - General" general) :to-be 13)
        (cl-weave:expect (search "q, Q, Ctrl-c            Quit" quit) :to-be 13)
        (cl-weave:expect (char intro 106) :to-equal #\▲)
        (cl-weave:expect (char (cl-tty-kit:screen-row-string screen 31) 106)
                         :to-equal #\▼)
        (cl-weave:expect (char bottom 12) :to-equal #\└)
        (cl-weave:expect (char bottom 107) :to-equal #\┘)
        (cl-weave:expect (every (lambda (character) (char= character #\Space)) outside)
                         :to-be t)
        (cl-weave:expect
         (cl-tty-kit:cell-style (cl-tty-kit:screen-cell screen 0 0))
         :to-equal (ntop.app.presentation::%screen-style :default :general-widget)))))
  (cl-weave:it "keeps the search row below a small help frame"
    (let* ((config (ntop.shared.application:make-application-config))
           (composition (ntop.app.application:make-application-composition config))
           (render (ntop.app.application:application-composition-render composition))
           (state (ntop.app.domain:make-app-state :selected-widget :process)))
      (setf (ntop.app.domain:app-state-active-dialog state) :help-search
            (gethash :help (ntop.app.domain:app-state-widget-v-states state))
            (ntop.app.presentation:make-help-state :query "GPU" :search-active-p t))
      (with-output-to-string (stream)
        (let ((*standard-output* stream))
          (funcall render state config nil 80 24 nil)))
      (let* ((screen (ntop.app.application::application-composition-screen composition))
             (top (cl-tty-kit:screen-row-string screen 0))
             (first-entry (cl-tty-kit:screen-row-string screen 1))
             (search-row (cl-tty-kit:screen-row-string screen 23))
             (bottom (cl-tty-kit:screen-row-string screen 22)))
        (cl-weave:expect (char top 0) :to-equal #\┌)
        (cl-weave:expect (search " Help " top) :to-be 1)
        (cl-weave:expect (search "Esc to close" top) :to-be 66)
        (cl-weave:expect (search "3 - Process widget" first-entry) :to-be 1)
        (cl-weave:expect (search "Search: GPU" search-row) :to-be 0)
        (cl-weave:expect (char bottom 0) :to-equal #\└)
        (cl-weave:expect (char bottom 79) :to-equal #\┘)))))

